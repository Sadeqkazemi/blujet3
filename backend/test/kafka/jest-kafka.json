{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "kafka/.*\\.kafka-spec\\.ts$",
  "maxWorkers": 1,
  "testTimeout": 120000,
  "setupFiles": ["<rootDir>/jest-setup.ts"],
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
  "transform": { "^.+\\.(t|j)s$": "ts-jest" }
}
