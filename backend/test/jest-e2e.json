{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 1,
  "testTimeout": 20000,
  "testPathIgnorePatterns": ["ops-admin-projection-consumer.e2e-spec.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": ["<rootDir>/jest-setup.ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
