NODE_ENV=development
AUTH_SANDBOX_ENABLED=true
AUTH_SANDBOX_OTP=123456
PORT=3000

DATABASE_URL="postgresql://blujet:blujet@localhost:5432/blujet?schema=public"
REDIS_URL="redis://localhost:6379"
KAFKA_EVENTS_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=blujet-core
KAFKA_EVENTS_TOPIC=blujet.events.v1

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# Internal-only FastAPI service — never exposed to the frontend/internet.
ML_SERVICE_URL="http://ml-service:8000"
ML_SERVICE_INTERNAL_TOKEN="change-me"

# SMS OTP / notifications — the real Kavenegar API key is NOT an env
# var: it's set/rotated live from پنل مدیر IT → سرویس‌های خارجی (the
# same encrypted-at-rest ExternalServiceConfig row used for زرین‌پال/
# آمادئوس/نشان). Falls back to a log-only mock automatically until an
# IT_MANAGER enables it there. KAVENEGAR_SENDER_LINE below is the only
# SMS-related env var — it's your approved originator line, not a
# secret, and optional (Kavenegar uses the account default if unset).
KAVENEGAR_SENDER_LINE=

# Payment gateway (Shetab/IPG) — sandbox driver in dev
PAYMENT_GATEWAY="sandbox"

# Error tracking — omit to disable in local dev
SENTRY_DSN=

CORS_ORIGINS="http://localhost:5173"

# HTTP edge / API Gateway. Production runs behind one trusted Nginx hop.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_TIMEOUT_MS=30000
API_MAX_BODY_BYTES=10485760
TRUST_PROXY_HOPS=0
HTTPS_ENABLED=false

# Bump to invalidate all search/catalogue cache keys after a release.
SEARCH_CACHE_GEN=v1

# Phase-1 notify strangler. Enable only when notify-service is deployed and
# healthy; the token must match NOTIFY_INTERNAL_TOKEN in that service.
NOTIFY_INTEGRATION_ENABLED=false
NOTIFY_SERVICE_URL=http://localhost:3200
NOTIFY_INTERNAL_TOKEN="generate-a-random-secret-at-least-32-characters"
NOTIFY_REQUEST_TIMEOUT_MS=3000
NOTIFY_EVENT_TIMEOUT_MS=15000
NOTIFY_OUTBOX_POLL_MS=1000

# Core-owned PostgreSQL worker that materializes overdue 15-minute booking holds.
BOOKING_EXPIRY_WORKER_ENABLED=true
BOOKING_EXPIRY_POLL_MS=30000

# Phase 2 Experience strangler. Keep false until experience-service is healthy.
EXPERIENCE_INTEGRATION_ENABLED=false
EXPERIENCE_SERVICE_URL=http://localhost:3300
EXPERIENCE_INTERNAL_TOKEN="generate-a-random-secret-at-least-32-characters"
EXPERIENCE_REQUEST_TIMEOUT_MS=3000

# A6.1 offline comparison ONLY; never switches public reads or starts a worker.
LOYALTY_SHADOW_ENABLED=false
# A6.10 optional points read cutover; Core remains fallback and sole writer.
LOYALTY_POINTS_READ_ENABLED=false
LOYALTY_PRICE_LOCK_READ_ENABLED=false
LOYALTY_MEMBERSHIP_READ_ENABLED=false
LOYALTY_TIER_RULES_READ_ENABLED=false
LOYALTY_MEMBERS_LIST_READ_ENABLED=false
LOYALTY_CARD_REQUESTS_READ_ENABLED=false
LOYALTY_SERVICE_URL=http://localhost:3500
LOYALTY_INTERNAL_TOKEN="generate-a-separate-random-secret-at-least-32-characters"

PII_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

# Real Anthropic API key for the passenger-survey AI summary (Phase 66).
# Omit to disable AI summaries in local dev — the endpoint still works,
# it just returns the design's own fallback string instead of a summary.
ANTHROPIC_API_KEY=

# Public frontend origin — used only to build the survey link sent by SMS.
FRONTEND_URL="http://localhost:5173"

# Bank loan adapter (optional). Never hard-code bank name/URL in code.
# Use the bank's official sandbox URL in non-prod. Leave unset to disable.
BANK_LOAN_API_BASE_URL=
BANK_LOAN_API_KEY=
BANK_LOAN_WEBHOOK_SECRET=
BANK_LOAN_TIMEOUT_MS=5000

# Offline Agency profile/invoice-page comparison only; never a public cutover.
AGENCY_SHADOW_ENABLED=false
AGENCY_PROFILE_READ_ENABLED=false
AGENCY_INVOICES_READ_ENABLED=false
AGENCY_CREDIT_REQUESTS_READ_ENABLED=false
# Enabling profile or invoice reads requires a UTC Node runtime (TZ=UTC) and the matching Agency compatibility reader grants.
AGENCY_SERVICE_URL="http://agency-service:3600"
AGENCY_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"

# Central PSS cutover. Keep disabled until the migration slice is approved.
PSS_INTEGRATION_ENABLED=false
PSS_SERVICE_URL="http://pss-service:3100"
PSS_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
PSS_REQUEST_TIMEOUT_MS=3000

# Phase 4 identity cutover. Keep disabled until identity-service is provisioned.
IDENTITY_INTEGRATION_ENABLED=false
# legacy: HS256 only; identity: RS256 only; dual: rollback mode accepting both.
IDENTITY_JWT_VERIFICATION_MODE=legacy
IDENTITY_SERVICE_URL="http://identity-service:3400"
IDENTITY_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
IDENTITY_JWKS_CACHE_TTL_MS=300000
IDENTITY_JWT_ISSUER="https://identity.internal.blujet"
IDENTITY_JWT_AUDIENCE="blujet-gateway"

# Finance-manager accounting connectors (optional; fail closed when absent).
FINANCE_HOLO_VERIFY_URL=
FINANCE_HOLO_SYNC_URL=
FINANCE_SEPIDAR_VERIFY_URL=
FINANCE_SEPIDAR_SYNC_URL=
FINANCE_HESABFA_VERIFY_URL=
FINANCE_HESABFA_SYNC_URL=
FINANCE_RAHKARAN_VERIFY_URL=
FINANCE_RAHKARAN_SYNC_URL=
FINANCE_PARMIS_VERIFY_URL=
FINANCE_PARMIS_SYNC_URL=
