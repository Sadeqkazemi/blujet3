NODE_ENV=development
AUTH_SANDBOX_ENABLED=true
AUTH_SANDBOX_OTP=123456
PORT=3000

DATABASE_URL="postgresql://blujet:blujet@localhost:5432/blujet?schema=public"
REDIS_URL="redis://localhost:6379"
KAFKA_EVENTS_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=blujet-core
KAFKA_EVENTS_TOPIC=blujet.events.v1
KAFKA_TLS_ENABLED=false
# Production requires TLS and SCRAM. Supply secrets outside Git.
# KAFKA_TLS_CA_PEM=
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Reporting projection consumer. This is independent from the Core publisher
# switch and remains off until broker ACLs, poison-event policy and UAT approve it.
REPORTING_KAFKA_CONSUMER_ENABLED=false
REPORTING_KAFKA_CLIENT_ID=blujet-reporting
REPORTING_KAFKA_GROUP_ID=blujet-reporting-v1
REPORTING_KAFKA_FROM_BEGINNING=true
REPORTING_KAFKA_MAX_BYTES=262144
# Keep false until the legacy backlog without schema headers is drained and UAT
# proves staged cutover/rollback. Invalid values fail closed at startup.
CORE_EVENT_SCHEMA_HEADER_REQUIRED=false
REPORTING_DLQ_ENABLED=false
REPORTING_DLQ_MAX_ATTEMPTS=3
REPORTING_DLQ_OPERATOR_TOKEN=
# Used only by the separate Reporting worker process. Its runtime role must be
# non-superuser and restricted to the reporting schema.
# Long-running Reporting worker credential. Provision offline with the owner URL
# below; never give the owner URL to the worker.
# REPORTING_DATABASE_URL=postgresql://blujet_reporting_projection_runtime:replace-with-32-url-safe-characters@localhost:5432/blujet_reporting
# REPORTING_DATABASE_OWNER_URL=postgresql://reporting_owner:replace@localhost:5432/blujet_reporting
# REPORTING_PROJECTION_RUNTIME_PASSWORD=replace-with-32-url-safe-characters
# Offline Reporting cutover readiness gate. Keep disabled; it never
# connects to Kafka or writes rows. Use dedicated read-only LOGIN roles,
# never owner/writer/runtime passwords. See
# docs/features/microservices-phase-6-reporting-cutover-readiness.md.
REPORTING_CUTOVER_CHECK_ENABLED=false
REPORTING_CUTOVER_SOURCE_DATABASE_URL="postgresql://blujet_reporting_cutover_source:replace@core-db:5432/blujet"
REPORTING_CUTOVER_TARGET_DATABASE_URL="postgresql://blujet_reporting_cutover_target:replace@reporting-db:5432/blujet_reporting"
REPORTING_CUTOVER_KAFKA_GROUP_ID="blujet-reporting-v1"
REPORTING_CUTOVER_KAFKA_TOPIC="blujet.events.v1"
REPORTING_CUTOVER_EXPECTED_PARTITIONS="0,1,2"
REPORTING_CUTOVER_BATCH_SIZE="100"
# Offline provisioners for the cutover reader roles. Both owner URLs are
# required; they are operator-only and must never reach a long-running process.
# Apply the documented PUBLIC ACL baseline before provisioning.
REPORTING_CUTOVER_SOURCE_OWNER_URL="postgresql://core_owner:replace@core-db:5432/blujet"
REPORTING_CUTOVER_SOURCE_PASSWORD="replace-with-32-url-safe-characters"
REPORTING_CUTOVER_TARGET_OWNER_URL="postgresql://reporting_owner:replace@reporting-db:5432/blujet_reporting"
REPORTING_CUTOVER_TARGET_PASSWORD="replace-with-32-url-safe-characters"
# Production uses a dedicated read/group identity; never reuse publisher credentials.
# REPORTING_KAFKA_SASL_MECHANISM=scram-sha-512
# REPORTING_KAFKA_SASL_USERNAME=
# REPORTING_KAFKA_SASL_PASSWORD=

# Standalone Ops/Admin projection consumer. This worker is not present in
# Compose/deployment manifests and must remain off until its isolated database,
# broker ACLs and UAT are approved.
OPS_ADMIN_KAFKA_CONSUMER_ENABLED=false
OPS_ADMIN_KAFKA_CLIENT_ID=blujet-ops-admin-projection
OPS_ADMIN_KAFKA_GROUP_ID=blujet-ops-admin-projection-v1
OPS_ADMIN_KAFKA_FROM_BEGINNING=true
OPS_ADMIN_KAFKA_MAX_BYTES=262144
# Poison-message quarantine stays disabled until retention/replay operations are approved.
OPS_ADMIN_DLQ_ENABLED=false
OPS_ADMIN_DLQ_MAX_ATTEMPTS=3
# OPS_ADMIN_DLQ_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
# Production uses a dedicated read/group identity; never reuse publisher credentials.
# OPS_ADMIN_KAFKA_SASL_MECHANISM=scram-sha-512
# OPS_ADMIN_KAFKA_SASL_USERNAME=
# OPS_ADMIN_KAFKA_SASL_PASSWORD=

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# Internal-only FastAPI service — never exposed to the frontend/internet.
ML_SERVICE_URL="http://ml-service:8000"
ML_SERVICE_INTERNAL_TOKEN="change-me"

# SMS OTP / notifications — the real Kavenegar API key is NOT an env
# var: it's set/rotated live from پنل مدیر IT → سرویس‌های خارجی (the
# same encrypted-at-rest ExternalServiceConfig row used for زرین‌پال/
# آمادئوس/نشان). Falls back to a log-only mock automatically until an
# IT_MANAGER enables it there. KAVENEGAR_SENDER_LINE below is the only
# SMS-related env var — it's your approved originator line, not a
# secret, and optional (Kavenegar uses the account default if unset).
KAVENEGAR_SENDER_LINE=

# Payment gateway (Shetab/IPG) — sandbox driver in dev
PAYMENT_GATEWAY="sandbox"

# Error tracking — omit to disable in local dev
SENTRY_DSN=

CORS_ORIGINS="http://localhost:5173"

# HTTP edge / API Gateway. Production runs behind one trusted Nginx hop.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_TIMEOUT_MS=30000
API_MAX_BODY_BYTES=10485760
TRUST_PROXY_HOPS=0
HTTPS_ENABLED=false

# Bump to invalidate all search/catalogue cache keys after a release.
SEARCH_CACHE_GEN=v1

# Phase-1 notify strangler. Enable only when notify-service is deployed and
# healthy; the token must match NOTIFY_INTERNAL_TOKEN in that service.
NOTIFY_INTEGRATION_ENABLED=false
NOTIFY_SERVICE_URL=http://localhost:3200
NOTIFY_INTERNAL_TOKEN="generate-a-random-secret-at-least-32-characters"
NOTIFY_REQUEST_TIMEOUT_MS=3000
NOTIFY_EVENT_TIMEOUT_MS=15000
NOTIFY_OUTBOX_POLL_MS=1000

# Core-owned PostgreSQL worker that materializes overdue 15-minute booking holds.
BOOKING_EXPIRY_WORKER_ENABLED=true
BOOKING_EXPIRY_POLL_MS=30000

# Phase 2 Experience strangler. Keep false until experience-service is healthy.
EXPERIENCE_INTEGRATION_ENABLED=false
EXPERIENCE_SERVICE_URL=http://localhost:3300
EXPERIENCE_INTERNAL_TOKEN="generate-a-random-secret-at-least-32-characters"
EXPERIENCE_REQUEST_TIMEOUT_MS=3000

# A6.1 offline comparison ONLY; never switches public reads or starts a worker.
LOYALTY_SHADOW_ENABLED=false
# A6.10 optional points read cutover; Core remains fallback and sole writer.
LOYALTY_POINTS_READ_ENABLED=false
LOYALTY_PRICE_LOCK_READ_ENABLED=false
LOYALTY_MEMBERSHIP_READ_ENABLED=false
LOYALTY_TIER_RULES_READ_ENABLED=false
LOYALTY_MEMBERS_LIST_READ_ENABLED=false
LOYALTY_CARD_REQUESTS_READ_ENABLED=false
LOYALTY_SERVICE_URL=http://localhost:3500
LOYALTY_INTERNAL_TOKEN="generate-a-separate-random-secret-at-least-32-characters"

PII_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

# Real Anthropic API key for the passenger-survey AI summary (Phase 66).
# Omit to disable AI summaries in local dev — the endpoint still works,
# it just returns the design's own fallback string instead of a summary.
ANTHROPIC_API_KEY=

# Public frontend origin — used only to build the survey link sent by SMS.
FRONTEND_URL="http://localhost:5173"

# Bank loan adapter (optional). Never hard-code bank name/URL in code.
# Use the bank's official sandbox URL in non-prod. Leave unset to disable.
BANK_LOAN_API_BASE_URL=
BANK_LOAN_API_KEY=
BANK_LOAN_WEBHOOK_SECRET=
BANK_LOAN_TIMEOUT_MS=5000

# Offline Agency profile/invoice-page comparison only; never a public cutover.
AGENCY_SHADOW_ENABLED=false
AGENCY_PROFILE_READ_ENABLED=false
AGENCY_INVOICES_READ_ENABLED=false
AGENCY_CREDIT_REQUESTS_READ_ENABLED=false
# Enabling profile or invoice reads requires a UTC Node runtime (TZ=UTC) and the matching Agency compatibility reader grants.
AGENCY_SERVICE_URL="http://agency-service:3600"
AGENCY_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"

# Central PSS cutover. Keep disabled until the migration slice is approved.
PSS_INTEGRATION_ENABLED=false
PSS_SERVICE_URL="http://pss-service:3100"
PSS_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
PSS_REQUEST_TIMEOUT_MS=3000

# Internal Core signed offers. The endpoint fails closed when the secret is absent.
CORE_OFFER_SIGNING_SECRET="replace-with-at-least-32-random-characters"
CORE_OFFER_TTL_SECONDS=900
OFFER_SERVICE_ENABLED=false
OFFER_SERVICE_URL="http://offer-pricing:3600"
OFFER_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
OFFER_REQUEST_TIMEOUT_MS=3000
# Standalone Offer process only; use a SELECT-only, default-read-only role.
OFFER_DATABASE_URL="postgresql://blujet_offer_reader:replace@db:5432/blujet"

# Standalone Ticketing/Refund read-only process (opt-in internal profile only).
TICKETING_REFUND_DATABASE_URL="postgresql://blujet_ticketing_refund_reader:replace@db:5432/blujet"
TICKETING_REFUND_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
PAYMENT_RECONCILIATION_DATABASE_URL="postgresql://blujet_payment_reconciliation_reader:replace@db:5432/blujet"
PAYMENT_RECONCILIATION_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
# Standalone Order/Booking read-only process (opt-in internal profile only).
ORDER_BOOKING_DATABASE_URL="postgresql://blujet_order_booking_reader:replace@db:5432/blujet"
ORDER_BOOKING_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
INVENTORY_DATABASE_URL="postgresql://blujet_inventory_reader:replace@db:5432/blujet"
INVENTORY_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
# Standalone Ops/Admin read-only cartable process (opt-in internal profile).
# The projection worker must use only this isolated database. In production its
# URL must authenticate as blujet_ops_admin_projection_runtime.
OPS_ADMIN_PROJECTION_DATABASE_URL="postgresql://blujet_ops_admin_projection_runtime:replace-with-32-url-safe-characters@db:5432/blujet_ops_admin"
# Offline owner URL for provisioning blujet_ops_admin_projection_runtime. Never
# point the long-running worker at this owner credential.
OPS_ADMIN_PROJECTION_DATABASE_OWNER_URL="postgresql://blujet:blujet@localhost:5432/blujet_ops_admin"
OPS_ADMIN_PROJECTION_RUNTIME_PASSWORD="replace-with-32-url-safe-characters"
# Offline HTTP reader on the isolated Ops/Admin database. Never reuse the
# projection-writer runtime password for HTTP reads.
OPS_ADMIN_PROJECTION_READER_PASSWORD="replace-with-32-url-safe-characters"
# Offline baseline copy. Keep APPLY false unless an operator is transferring
# into an empty projection database after a verified backup.
OPS_ADMIN_BASELINE_SOURCE_DATABASE_URL="postgresql://core_owner:replace@core-db:5432/blujet"
OPS_ADMIN_BASELINE_TARGET_DATABASE_URL="postgresql://ops_admin_owner:replace@ops-admin-db:5432/blujet_ops_admin"
OPS_ADMIN_BASELINE_APPLY="false"
# Host path for direct CLI execution and the read-only Compose bind mount.
OPS_ADMIN_BASELINE_BACKUP_PATH="./backups/ops-admin-baseline.dump"
OPS_ADMIN_BASELINE_BACKUP_SHA256=""
OPS_ADMIN_BASELINE_BATCH_SIZE="100"
# Offline Ops/Admin cutover readiness gate. Keep disabled; it never
# connects to Kafka or writes rows. Use dedicated read-only LOGIN roles,
# never owner/writer/HTTP-reader passwords. See the GRANT contract in
# docs/features/microservices-phase-6-ops-admin-cutover-readiness.md.
OPS_ADMIN_CUTOVER_CHECK_ENABLED=false
OPS_ADMIN_CUTOVER_SOURCE_DATABASE_URL="postgresql://blujet_ops_admin_cutover_source:replace@core-db:5432/blujet"
OPS_ADMIN_CUTOVER_TARGET_DATABASE_URL="postgresql://blujet_ops_admin_cutover_target:replace@ops-admin-db:5432/blujet_ops_admin"
OPS_ADMIN_CUTOVER_KAFKA_GROUP_ID="blujet.ops-admin.cartable"
OPS_ADMIN_CUTOVER_KAFKA_TOPIC="blujet.ops-admin.cartable.v1"
OPS_ADMIN_CUTOVER_EXPECTED_PARTITIONS="0,1,2"
OPS_ADMIN_CUTOVER_BATCH_SIZE="100"
OPS_ADMIN_DATABASE_URL="postgresql://blujet_ops_admin_reader:replace@db:5432/blujet"
OPS_ADMIN_CARTABLE_UNREAD_READ_ENABLED=false
OPS_ADMIN_CARTABLE_COUNTS_READ_ENABLED=false
OPS_ADMIN_SERVICE_URL="http://ops-admin:3660"
OPS_ADMIN_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
OPS_ADMIN_RECONCILIATION_SOURCE_DATABASE_URL="postgresql://blujet_ops_admin_reconcile_source:replace@db:5432/blujet"
OPS_ADMIN_RECONCILIATION_TARGET_DATABASE_URL="postgresql://blujet_ops_admin_reconcile_target:replace@db:5432/blujet_ops_admin"

# Offline independent-domain database provisioning and one-time transfer tools.
# Never pass owner/source URLs to a long-running HTTP process.
DOMAIN_DATABASE_KIND="notify"
DOMAIN_DATABASE_OWNER_URL="postgresql://domain_owner:replace@db:5432/blujet_notify"
NOTIFY_DATABASE_PASSWORD="replace-with-32-url-safe-characters"
EXPERIENCE_DATABASE_PASSWORD="replace-with-32-url-safe-characters"
IDENTITY_DATABASE_PASSWORD="replace-with-32-url-safe-characters"
LOYALTY_DATABASE_PASSWORD="replace-with-32-url-safe-characters"
AGENCY_DATABASE_PASSWORD="replace-with-32-url-safe-characters"
# Offline Agency cutover readiness gate. Keep disabled; never Kafka.
AGENCY_CUTOVER_CHECK_ENABLED=false
AGENCY_CUTOVER_SOURCE_DATABASE_URL="postgresql://blujet_agency_cutover_source:replace@core-db:5432/blujet"
AGENCY_CUTOVER_TARGET_DATABASE_URL="postgresql://blujet_agency_cutover_target:replace@agency-db:5432/blujet_agency"
AGENCY_CUTOVER_KAFKA_GROUP_ID="blujet-agency-projection-v1"
AGENCY_CUTOVER_KAFKA_TOPIC="blujet.events.v1"
AGENCY_CUTOVER_EXPECTED_PARTITIONS="0,1,2"
AGENCY_CUTOVER_BATCH_SIZE="100"
DOMAIN_TRANSFER_KIND="notify"
DOMAIN_TRANSFER_SOURCE_DATABASE_URL="postgresql://domain_source_reader:replace@core-db:5432/blujet"
DOMAIN_TRANSFER_TARGET_DATABASE_URL="postgresql://domain_owner:replace@domain-db:5432/blujet_notify"
DOMAIN_TRANSFER_APPLY="false"
DOMAIN_TRANSFER_BACKUP_REFERENCE=""
DOMAIN_TRANSFER_BATCH_SIZE="100"

# Phase 4 identity cutover. Keep disabled until identity-service is provisioned.
IDENTITY_INTEGRATION_ENABLED=false
# legacy: HS256 only; identity: RS256 only; dual: rollback mode accepting both.
IDENTITY_JWT_VERIFICATION_MODE=legacy
IDENTITY_SERVICE_URL="http://identity-service:3400"
IDENTITY_INTERNAL_TOKEN="replace-with-at-least-32-random-characters"
IDENTITY_JWKS_CACHE_TTL_MS=300000
IDENTITY_JWT_ISSUER="https://identity.internal.blujet"
IDENTITY_JWT_AUDIENCE="blujet-gateway"

# Finance-manager accounting connectors (optional; fail closed when absent).
FINANCE_HOLO_VERIFY_URL=
FINANCE_HOLO_SYNC_URL=
FINANCE_SEPIDAR_VERIFY_URL=
FINANCE_SEPIDAR_SYNC_URL=
FINANCE_HESABFA_VERIFY_URL=
FINANCE_HESABFA_SYNC_URL=
FINANCE_RAHKARAN_VERIFY_URL=
FINANCE_RAHKARAN_SYNC_URL=
FINANCE_PARMIS_VERIFY_URL=
FINANCE_PARMIS_SYNC_URL=
