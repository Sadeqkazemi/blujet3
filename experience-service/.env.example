NODE_ENV="development"
PORT="3300"
# Development placeholder for a dedicated experience writer role. The bundled
# docker-compose.yml may override this with its local-only database user.
EXPERIENCE_DATABASE_URL="postgresql://experience_writer:replace-me@localhost:5432/blujet?schema=experience"
EXPERIENCE_INTERNAL_TOKEN="generate-a-random-secret-at-least-32-characters"
PII_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"
EXPERIENCE_UPLOAD_DIR="./uploads"
