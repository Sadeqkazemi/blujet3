# Copy to .env (same directory as docker-compose.prod.yml) and fill in
# real values before running `docker compose -f docker-compose.prod.yml up -d --build`.

# The bare server's public IP — used to build the frontend's API base URL
# and to lock down backend CORS. No domain needed for IP-only access.
SERVER_IP=203.0.113.10

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PII_ENCRYPTION_KEY=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Separate login used only by the long-running Core Backend. The database owner
# above is retained by the short-lived migration/provisioning jobs only.
CORE_DATABASE_PASSWORD=

# Offer/Pricing is an opt-in read process. Keep both exposure and cutover off
# until its restricted reader, parity evidence and health checks are accepted.
# CORE_OFFER_SIGNING_SECRET must be shared with Core so Hold can verify tokens.
CORE_OFFER_SIGNING_SECRET=
CORE_OFFER_TTL_SECONDS=900
CORE_OFFER_PUBLIC_ENABLED=false
OFFER_SERVICE_ENABLED=false
OFFER_DATABASE_PASSWORD=
OFFER_INTERNAL_TOKEN=
OFFER_REQUEST_TIMEOUT_MS=3000

# Dedicated non-transactional databases. The *_POSTGRES_PASSWORD values belong
# only to short-lived migration/transfer jobs; long-running services use fixed
# restricted non-superuser roles with separate *_DATABASE_PASSWORD values.
# Keep the URLs blank until backup, transfer/checksum parity and UAT pass.
NOTIFY_POSTGRES_PASSWORD=
NOTIFY_DATABASE_PASSWORD=
NOTIFY_DATABASE_URL=
EXPERIENCE_POSTGRES_PASSWORD=
EXPERIENCE_DATABASE_PASSWORD=
EXPERIENCE_DATABASE_URL=
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_DATABASE_PASSWORD=
IDENTITY_DATABASE_URL=
# Dedicated Reporting schema writer. The opt-in reporting Compose profile will
# fail closed until this URL and the Kafka settings below are supplied.
REPORTING_DATABASE_URL=

# Reporting event consumer (used only by the opt-in `reporting` profile).
KAFKA_BROKERS=
KAFKA_EVENTS_TOPIC=blujet.events.v1
KAFKA_TLS_ENABLED=true
# Optional private CA bundle in PEM form; system trust is used when empty.
KAFKA_TLS_CA_PEM=
REPORTING_KAFKA_CLIENT_ID=blujet-reporting
REPORTING_KAFKA_GROUP_ID=blujet-reporting-v1
REPORTING_KAFKA_FROM_BEGINNING=true
REPORTING_KAFKA_MAX_BYTES=262144
REPORTING_DLQ_ENABLED=false
REPORTING_DLQ_MAX_ATTEMPTS=3
REPORTING_DLQ_OPERATOR_TOKEN=
REPORTING_KAFKA_SASL_MECHANISM=scram-sha-512
REPORTING_KAFKA_SASL_USERNAME=
REPORTING_KAFKA_SASL_PASSWORD=

# Payment/Reconciliation is a default-off, read-only internal process. Its
# role is provisioned by a short-lived migration job; it never receives the
# Core owner URL and never executes PSP callbacks or financial writes.
PAYMENT_RECONCILIATION_DATABASE_PASSWORD=
PAYMENT_RECONCILIATION_INTERNAL_TOKEN=
PAYMENT_RECONCILIATION_REQUEST_TIMEOUT_MS=10000

# Order/Booking is a default-off, read-only internal process. Core remains the
# sole writer for Order, Hold expiry, Inventory and Payment.
ORDER_BOOKING_DATABASE_PASSWORD=
ORDER_BOOKING_INTERNAL_TOKEN=
ORDER_BOOKING_REQUEST_TIMEOUT_MS=10000
INVENTORY_DATABASE_PASSWORD=
INVENTORY_INTERNAL_TOKEN=
INVENTORY_REQUEST_TIMEOUT_MS=10000

# Ops/Admin is a default-off, read-only cartable observation process. Core
# remains the sole writer for task creation, referral, transfer and resolution.
OPS_ADMIN_DATABASE_PASSWORD=
OPS_ADMIN_INTERNAL_TOKEN=
OPS_ADMIN_PROJECTION_DATABASE_URL=
OPS_ADMIN_REQUEST_TIMEOUT_MS=10000

# PostgreSQL PITR: WAL is archived continuously to a separate Docker volume.
# Run scripts/backup-base-pitr.sh daily; keep at least a seven-day window.
BACKUP_DIR=/opt/app/backups
PITR_BASE_RETENTION_DAYS=7
POSTGRES_ARCHIVE_TIMEOUT=300s

# Shared secret the backend sends to the ml-service on every internal call.
# Generate with: openssl rand -hex 24
ML_SERVICE_INTERNAL_TOKEN=

# Keep disabled until a certified PSP adapter is implemented/configured.
# `sandbox` is accepted only outside NODE_ENV=production.
PAYMENT_GATEWAY=disabled

# Optional — leave empty to disable Sentry error tracking (backend and
# frontend each have their own DSN in Sentry; can be the same project).
SENTRY_DSN=
VITE_SENTRY_DSN=

# Set to true only for the very first boot to load demo/seed data
# (test accounts, sample flights). Never leave true in an ongoing deployment.
SEED_ON_START=false

# Finance-manager accounting connectors. Use each vendor's official
# verification and document-sync endpoints. Leave blank to keep that card
# fail-closed (the UI will show «پیکربندی سرور تکمیل نشده»).
FINANCE_HOLO_VERIFY_URL=
FINANCE_HOLO_SYNC_URL=
FINANCE_SEPIDAR_VERIFY_URL=
FINANCE_SEPIDAR_SYNC_URL=
FINANCE_HESABFA_VERIFY_URL=
FINANCE_HESABFA_SYNC_URL=
FINANCE_RAHKARAN_VERIFY_URL=
FINANCE_RAHKARAN_SYNC_URL=
FINANCE_PARMIS_VERIFY_URL=
FINANCE_PARMIS_SYNC_URL=

# Temporary sandbox/UAT only. Enables audited 15-minute owner preview
# sessions for existing customer and agency accounts. Must be false at go-live.
SANDBOX_SUPER_ADMIN_TENANT_ACCESS=false

# API Gateway defaults. TRUST_PROXY_HOPS=1 matches the bundled Nginx edge.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_TIMEOUT_MS=30000
API_MAX_BODY_BYTES=10485760
TRUST_PROXY_HOPS=1
# Set true only after HTTPS/TLS termination is configured.
HTTPS_ENABLED=false
