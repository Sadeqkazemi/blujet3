# Copy to .env (same directory as docker-compose.prod.yml) and fill in
# real values before running `docker compose -f docker-compose.prod.yml up -d --build`.

# The bare server's public IP — used to build the frontend's API base URL
# and to lock down backend CORS. No domain needed for IP-only access.
SERVER_IP=203.0.113.10

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PII_ENCRYPTION_KEY=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Shared secret the backend sends to the ml-service on every internal call.
# Generate with: openssl rand -hex 24
ML_SERVICE_INTERNAL_TOKEN=

# Keep disabled until a certified PSP adapter is implemented/configured.
# `sandbox` is accepted only outside NODE_ENV=production.
PAYMENT_GATEWAY=disabled

# Optional — leave empty to disable Sentry error tracking (backend and
# frontend each have their own DSN in Sentry; can be the same project).
SENTRY_DSN=
VITE_SENTRY_DSN=

# Set to true only for the very first boot to load demo/seed data
# (test accounts, sample flights). Never leave true in an ongoing deployment.
SEED_ON_START=false

# Finance-manager accounting connectors. Use each vendor's official
# verification and document-sync endpoints. Leave blank to keep that card
# fail-closed (the UI will show «پیکربندی سرور تکمیل نشده»).
FINANCE_HOLO_VERIFY_URL=
FINANCE_HOLO_SYNC_URL=
FINANCE_SEPIDAR_VERIFY_URL=
FINANCE_SEPIDAR_SYNC_URL=
FINANCE_HESABFA_VERIFY_URL=
FINANCE_HESABFA_SYNC_URL=
FINANCE_RAHKARAN_VERIFY_URL=
FINANCE_RAHKARAN_SYNC_URL=
FINANCE_PARMIS_VERIFY_URL=
FINANCE_PARMIS_SYNC_URL=

# Temporary sandbox/UAT only. Enables audited 15-minute owner preview
# sessions for existing customer and agency accounts. Must be false at go-live.
SANDBOX_SUPER_ADMIN_TENANT_ACCESS=false

# API Gateway defaults. TRUST_PROXY_HOPS=1 matches the bundled Nginx edge.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_TIMEOUT_MS=30000
API_MAX_BODY_BYTES=10485760
TRUST_PROXY_HOPS=1
# Set true only after HTTPS/TLS termination is configured.
HTTPS_ENABLED=false
