NODE_ENV=development
PORT=3500
# Same PostgreSQL cluster; use a separately provisioned SELECT-only role.
LOYALTY_DATABASE_URL=postgresql://loyalty_reader:replace-me@localhost:5432/blujet
LOYALTY_INTERNAL_TOKEN=replace-with-a-random-token-at-least-32-characters
LOYALTY_MEMBERSHIP_PROJECTION_ENABLED=false
LOYALTY_TIER_RULES_PROJECTION_ENABLED=false
LOYALTY_MEMBERS_LIST_PROJECTION_ENABLED=false
LOYALTY_CARD_REQUESTS_PROJECTION_ENABLED=false
# Offline reconciliation only; use separately provisioned read-only credentials.
LOYALTY_RECONCILIATION_SOURCE_DATABASE_URL=postgresql://loyalty_source_reader:replace-me@localhost:5432/blujet
LOYALTY_RECONCILIATION_TARGET_DATABASE_URL=postgresql://loyalty_target_reader:replace-me@localhost:5432/blujet_loyalty
# Offline, metadata-only readiness gate. Keep false until an approved UAT
# freeze/replay window; both credentials must be separately restricted readers.
LOYALTY_CUTOVER_CHECK_ENABLED=false
LOYALTY_CUTOVER_SOURCE_DATABASE_URL=postgresql://loyalty_cutover_source:replace-me@localhost:5432/blujet
LOYALTY_CUTOVER_TARGET_DATABASE_URL=postgresql://loyalty_cutover_target:replace-me@localhost:5432/blujet_loyalty
LOYALTY_CUTOVER_KAFKA_GROUP_ID=blujet-loyalty-projection-v1
LOYALTY_CUTOVER_KAFKA_TOPIC=blujet.events.v1
LOYALTY_CUTOVER_EXPECTED_PARTITIONS=0,1,2
LOYALTY_CUTOVER_RECONCILIATION_LIMIT=10000
