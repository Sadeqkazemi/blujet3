NODE_ENV=development
PORT=3510
# Standalone projection worker only. Never give this writer URL to HTTP.
LOYALTY_PROJECTION_DATABASE_URL=postgresql://loyalty_projection_writer:replace-me@localhost:5432/blujet_loyalty
LOYALTY_KAFKA_CONSUMER_ENABLED=false
KAFKA_BROKERS=localhost:9092
LOYALTY_KAFKA_TOPIC=blujet.events.v1
LOYALTY_KAFKA_CLIENT_ID=blujet-loyalty
LOYALTY_KAFKA_GROUP_ID=blujet-loyalty-projection-v1
LOYALTY_KAFKA_FROM_BEGINNING=true
LOYALTY_KAFKA_MAX_BYTES=262144
LOYALTY_EVENT_SCHEMA_HEADER_REQUIRED=false
LOYALTY_KAFKA_TLS_ENABLED=false
# Production requires TLS and dedicated SCRAM credentials. Never commit secrets.
# LOYALTY_KAFKA_TLS_CA_PEM=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# LOYALTY_KAFKA_SASL_MECHANISM=scram-sha-512
# LOYALTY_KAFKA_SASL_USERNAME=replace-me
# LOYALTY_KAFKA_SASL_PASSWORD=replace-me
