  "components": {
    "securitySchemes": {
      "internal": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token"
      }
    },
    "schemas": {
      "ErrorDetails": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED",
              "FORBIDDEN",
              "VALIDATION_FAILED",
              "NOT_FOUND",
              "CONFLICT",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "description": "پیام امن فارسی",
            "example": "درخواست قابل پردازش نیست."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "PortalProfileView": {
        "type": "object",
        "properties": {
          "agencyId": {
            "type": "string",
            "description": "شناسه حساب آژانس",
            "format": "uuid"
          },
          "city": {
            "type": "string",
            "description": "شهر",
            "example": "تهران"
          },
          "tier": {
            "type": "string",
            "description": "سطح ثبت‌شده",
            "example": "NORMAL"
          },
          "joinedAt": {
            "type": "string",
            "description": "زمان عضویت UTC",
            "format": "date-time"
          },
          "suspendedAt": {
            "type": "string",
            "description": "زمان تعلیق پرتال؛ مجوز Partner API نیست",
            "nullable": true,
            "format": "date-time"
          },
          "managerName": {
            "type": "string",
            "description": "نام مدیر یا نماینده آژانس",
            "example": "علی رضایی"
          },
          "licenseNo": {
            "type": "string",
            "description": "شماره مجوز آژانس",
            "example": "AG-1405-001"
          },
          "phone": {
            "type": "string",
            "description": "شماره تماس ثبت‌شده آژانس",
            "example": "02112345678"
          },
          "email": {
            "type": "string",
            "description": "ایمیل ثبت‌شده آژانس",
            "example": "agency@example.com"
          },
          "address": {
            "type": "string",
            "description": "نشانی ثبت‌شده آژانس",
            "example": "تهران، خیابان آزادی"
          },
          "suspendReason": {
            "type": "string",
            "description": "علت تعلیق پرتال",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "agencyId",
          "city",
          "tier",
          "joinedAt",
          "suspendedAt",
          "managerName",
          "licenseNo",
          "phone",
          "email",
          "address",
          "suspendReason"
        ]
      },
      "PortalProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/PortalProfileView"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "PortalInvoiceView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "شناسه فاکتور",
            "format": "uuid"
          },
          "invoiceNo": {
            "type": "string",
            "description": "شماره فاکتور",
            "example": "INV-001"
          },
          "amountIrr": {
            "type": "string",
            "description": "مبلغ صحیح ریال؛ رشته دهدهی",
            "example": "9007199254740993"
          },
          "status": {
            "type": "string",
            "description": "وضعیت ثبت‌شده؛ مجوز پرداخت نیست",
            "example": "UNPAID"
          },
          "issuedAt": {
            "type": "string",
            "description": "زمان صدور UTC",
            "format": "date-time"
          },
          "dueAt": {
            "type": "string",
            "description": "سررسید UTC",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "description": "زمان پرداخت UTC",
            "nullable": true,
            "format": "date-time"
          },
          "agencyId": {
            "type": "string",
            "description": "شناسه مالک فاکتور",
            "format": "uuid",
            "example": "00000000-0000-4000-8000-000000000001"
          },
          "bookingId": {
            "type": "string",
            "description": "شناسه رزرو بدون اطلاعات مسافر",
            "nullable": true,
            "example": null
          },
          "issuedById": {
            "type": "string",
            "description": "شناسه صادرکننده بدون اطلاعات حساب",
            "format": "uuid",
            "example": "00000000-0000-4000-8000-000000000002"
          },
          "descriptionFa": {
            "type": "string",
            "description": "توضیح موجود فاکتور؛ فقط مالک مجاز",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "invoiceNo",
          "amountIrr",
          "status",
          "issuedAt",
          "dueAt",
          "paidAt",
          "agencyId",
          "bookingId",
          "issuedById",
          "descriptionFa"
        ]
      },
      "PortalInvoicesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortalInvoiceView"
            }
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
