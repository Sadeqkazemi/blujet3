        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/ProfileView"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "InvoiceView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "شناسه فاکتور",
