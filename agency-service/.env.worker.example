NODE_ENV=development
PORT=3610
# Standalone projection worker only. Never give this writer URL to HTTP.
AGENCY_PROJECTION_DATABASE_URL=postgresql://agency_projection_writer:replace-me@localhost:5432/blujet_agency
AGENCY_KAFKA_CONSUMER_ENABLED=false
KAFKA_BROKERS=localhost:9092
AGENCY_KAFKA_TOPIC=blujet.events.v1
AGENCY_KAFKA_CLIENT_ID=blujet-agency
AGENCY_KAFKA_GROUP_ID=blujet-agency-projection-v1
AGENCY_KAFKA_FROM_BEGINNING=true
AGENCY_KAFKA_MAX_BYTES=262144
AGENCY_EVENT_SCHEMA_HEADER_REQUIRED=false
AGENCY_DLQ_ENABLED=false
AGENCY_DLQ_MAX_ATTEMPTS=3
# Required only when AGENCY_DLQ_ENABLED=true; use a dedicated 32+ character secret.
AGENCY_DLQ_OPERATOR_TOKEN=
AGENCY_KAFKA_TLS_ENABLED=false
# Production requires TLS and dedicated SCRAM credentials. Never commit secrets.
# AGENCY_KAFKA_TLS_CA_PEM=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# AGENCY_KAFKA_SASL_MECHANISM=scram-sha-512
# AGENCY_KAFKA_SASL_USERNAME=replace-me
# AGENCY_KAFKA_SASL_PASSWORD=replace-me
