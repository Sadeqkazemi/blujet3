NODE_ENV=development
PORT=3600
# Same PostgreSQL cluster; use a separately provisioned SELECT-only role.
AGENCY_DATABASE_URL=postgresql://agency_reader:replace-me@localhost:5432/blujet
AGENCY_INTERNAL_TOKEN=replace-with-a-random-token-at-least-32-characters
AGENCY_PORTAL_PROFILE_ENABLED=false
AGENCY_PORTAL_INVOICES_ENABLED=false
AGENCY_PORTAL_CREDIT_REQUESTS_ENABLED=false
# Offline reconciliation only; supply distinct restricted read-only logins.
AGENCY_RECONCILIATION_SOURCE_DATABASE_URL=postgresql://agency_reconcile_source:replace-me@localhost:5432/blujet
AGENCY_RECONCILIATION_TARGET_DATABASE_URL=postgresql://agency_reconcile_target:replace-me@localhost:5432/blujet_agency
# Offline cutover readiness gate. Keep disabled; it never connects to Kafka.
AGENCY_CUTOVER_CHECK_ENABLED=false
AGENCY_CUTOVER_SOURCE_DATABASE_URL=postgresql://blujet_agency_cutover_source:replace-me@localhost:5432/blujet
AGENCY_CUTOVER_TARGET_DATABASE_URL=postgresql://blujet_agency_cutover_target:replace-me@localhost:5432/blujet_agency
AGENCY_CUTOVER_KAFKA_GROUP_ID=blujet-agency-projection-v1
AGENCY_CUTOVER_KAFKA_TOPIC=blujet.events.v1
AGENCY_CUTOVER_EXPECTED_PARTITIONS=0,1,2
AGENCY_CUTOVER_BATCH_SIZE=100
