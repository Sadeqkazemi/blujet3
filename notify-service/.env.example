NODE_ENV=development
PORT=3200
# Development placeholder for a dedicated notify writer role. The bundled
# docker-compose.yml may override this with its local-only database user.
NOTIFY_DATABASE_URL="postgresql://notify_writer:replace-me@localhost:5432/blujet?schema=notify"
NOTIFY_INTERNAL_TOKEN="generate-a-random-secret-at-least-32-characters"
PII_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"
SMS_PROVIDER_TIMEOUT_MS=10000
