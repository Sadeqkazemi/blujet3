          },
          "ticketDocumentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "auditId",
          "orderVersion",
          "currency",
          "status",
