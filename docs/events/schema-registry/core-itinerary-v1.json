{
  "OrderCreated": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "blujet.core-itinerary.OrderCreated.v1",
    "title": "OrderCreated Core itinerary event",
    "type": "object",
    "properties": {
      "eventId": {
        "type": "string",
        "format": "uuid"
      },
      "eventType": {
        "type": "string",
        "const": "OrderCreated"
      },
      "eventVersion": {
        "type": "integer",
        "const": 1
      },
      "occurredAt": {
        "type": "string",
        "format": "date-time"
      },
      "producer": {
        "type": "string",
        "const": "core-commerce"
      },
      "aggregateType": {
        "type": "string",
        "const": "CoreItineraryOrder"
      },
      "aggregateId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "correlationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "idempotencyKey": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "payload": {
        "type": "object",
        "properties": {
          "auditId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "orderVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "currency": {
            "type": "string",
            "const": "IRR"
          },
          "channel": {
            "type": "string",
            "enum": [
              "SYSTEM",
              "AGENCY"
            ]
          },
          "status": {
            "type": "string",
            "const": "HELD"
          },
          "fareIrr": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "maxLength": 19
          },
          "taxIrr": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "maxLength": 19
          },
          "extrasIrr": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "maxLength": 19
          },
          "totalIrr": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "maxLength": 19
          },
          "holdExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "auditId",
          "orderVersion",
          "currency",
          "channel",
          "status",
          "fareIrr",
          "taxIrr",
          "extrasIrr",
          "totalIrr",
          "holdExpiresAt"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "eventId",
      "eventType",
      "eventVersion",
      "occurredAt",
      "producer",
      "aggregateType",
      "aggregateId",
      "correlationId",
      "idempotencyKey",
      "payload"
    ],
    "additionalProperties": false
  },
