NODE_ENV=development
PORT=3400
IDENTITY_INTERNAL_TOKEN=replace-with-a-32-character-random-token
IDENTITY_JWT_KID=blujet-identity-2026-01
IDENTITY_JWT_ISSUER=https://identity.internal.blujet
IDENTITY_JWT_AUDIENCE=blujet-gateway
# PKCS#8 PEM; keep this in the deployment secret store, never in git.
IDENTITY_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
IDENTITY_REDIS_URL=redis://localhost:6379
# JSON array of old public JWKs retained for one access-token TTL during rotation.
IDENTITY_JWT_PREVIOUS_PUBLIC_JWKS=[]
